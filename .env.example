# BrandGuard AI - Production & Development Environment Configuration
# Keep this file secure. Never commit actual API keys to version control.

# Google Gemini API Key (Loaded strictly server-side by Node backend)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (optional, defaults to 3000 in dev and process.env.PORT in production)
PORT=3000
NODE_ENV=production
